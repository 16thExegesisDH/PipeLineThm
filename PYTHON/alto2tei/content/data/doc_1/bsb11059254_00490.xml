            <Shape><Polygon POINTS="547 1985 545 2001 2147 2017 2151 1993 2149 1962 547 1954 547 1985"/></Shape>
            <String CONTENT="nis autẽ præcepti eſt dilectio ex corde puroi &amp; cõſciẽtia bona &amp; fide nõ ficta. A quibus" HPOS="545.0" VPOS="1954.0" WIDTH="1606.0" HEIGHT="63.0" WC="0.9920072192731111"/>
          </TextLine>
          <TextLine ID="line_39" TAGREFS="LT8" BASELINE="545 2029 2147 2039" HPOS="543.0" VPOS="1997.0" WIDTH="1604.0" HEIGHT="66.0">
            <Shape><Polygon POINTS="545 2029 543 2047 2143 2063 2147 2039 2145 2007 545 1997 545 2029"/></Shape>
            <String CONTENT="quidã aberrãtes: ad vaniloquiũ cõuerſi ſũt.ꝗ volũt eſſe legis doctores: cũ nõ intelligãt." HPOS="543.0" VPOS="1997.0" WIDTH="1604.0" HEIGHT="66.0"/>
          </TextLine>
          <TextLine ID="line_40" TAGREFS="LT8" BASELINE="547 2075 2151 2084" HPOS="545.0" VPOS="2033.0" WIDTH="1606.0" HEIGHT="69.0">
