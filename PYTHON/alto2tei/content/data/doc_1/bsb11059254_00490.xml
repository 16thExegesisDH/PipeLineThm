            <String CONTENT=".ne q̃ loquũtur ne de quibꝰ affirmãt. ¶ Quę dilectio perfecta ſit &amp; quã lex intendit:" HPOS="545.0" VPOS="2033.0" WIDTH="1606.0" HEIGHT="69.0" WC="0.9858632336606036"/>
          </TextLine>
          <TextLine ID="line_41" TAGREFS="LT8" BASELINE="571 2120 2151 2128" HPOS="569.0" VPOS="2088.0" WIDTH="1582.0" HEIGHT="54.0">
            <Shape><Polygon POINTS="571 2120 569 2138 2147 2142 2151 2128 2149 2096 571 2088 571 2120"/></Shape>
            <String CONTENT="oſtẽdit, eſt eni dilectio puri cordis cõſciẽtiæ bonæ! &amp; fidei non fictæ, ſi eni cor purũ non" HPOS="569.0" VPOS="2088.0" WIDTH="1582.0" HEIGHT="54.0" WC="0.981907473411411"/>
          </TextLine>
          <TextLine ID="line_42" TAGREFS="LT8" BASELINE="573 2162 2153 2172" HPOS="571.0" VPOS="2124.0" WIDTH="1582.0" HEIGHT="65.0">
            <Shape><Polygon POINTS="1797 2128 1553 2136 1476 2126 1474 2126 1226 2134 1191 2124 1189 2124 1179 2124 1159 2124 1139 2124 1119 2124 1098 2124 1078 2124 1058 2124 1038 2124 1018 2124 997 2124 977 2124 573 2124 573 2162 571 2183 2149 2189 2153 2172 2151 2130 1858 2138 1799 2128 1797 2128"/></Shape>
            <String CONTENT="eſſet: quo modo eſſet perfecta dilectio|quæ eſt cordis &amp; aiæ! ſpũalis ſanitas! quãdoquidẽ" HPOS="571.0" VPOS="2124.0" WIDTH="1582.0" HEIGHT="65.0" WC="0.9843901376361432"/>
          </TextLine>
          <TextLine ID="line_43" TAGREFS="LT8" BASELINE="575 2205 2151 2217" HPOS="573.0" VPOS="2172.0" WIDTH="1578.0" HEIGHT="61.0">
            <Shape><Polygon POINTS="575 2205 573 2223 2147 2233 2151 2217 2149 2187 575 2172 575 2205"/></Shape>
            <String CONTENT="in corpore ĩpuroi ne eſt perfecta corporalis ſanitas? Cõſciẽtia bona: mens eſt conſcia" HPOS="573.0" VPOS="2172.0" WIDTH="1578.0" HEIGHT="61.0" WC="0.9877472162246704"/>
          </TextLine>
          <TextLine ID="line_44" TAGREFS="LT8" BASELINE="573 2249 2155 2261" HPOS="571.0" VPOS="2215.0" WIDTH="1584.0" HEIGHT="62.0">
            <Shape><Polygon POINTS="573 2249 571 2271 2151 2277 2155 2261 2155 2221 573 2215 573 2249"/></Shape>
            <String CONTENT="boni! &amp; quæ ſolũ bonũ &amp; vere bonũ vult. vt ex oppoſito conſcientia mala: mens eſt cõ" HPOS="571.0" VPOS="2215.0" WIDTH="1584.0" HEIGHT="62.0" WC="0.9935915145007047"/>
          </TextLine>
          <TextLine ID="line_45" TAGREFS="LT8" BASELINE="573 2292 2153 2306" HPOS="571.0" VPOS="2261.0" WIDTH="1582.0" HEIGHT="63.0">
            <Shape><Polygon POINTS="573 2292 571 2312 2149 2324 2153 2306 2151 2273 573 2261 573 2292"/></Shape>
            <String CONTENT="ſcia malil &amp; quæ malum cupit, non cum hac conſcientia: ſed cũ illa eſt perfecta dilectio." HPOS="571.0" VPOS="2261.0" WIDTH="1582.0" HEIGHT="63.0" WC="0.9896065420574612"/>
          </TextLine>
          <TextLine ID="line_46" TAGREFS="LT8" BASELINE="573 2338 2153 2350" HPOS="571.0" VPOS="2306.0" WIDTH="1582.0" HEIGHT="60.0">
            <Shape><Polygon POINTS="573 2338 571 2354 2149 2366 2153 2350 2151 2318 573 2306 573 2338"/></Shape>
            <String CONTENT="Si etiam ſimulas te fidem habere vt perfidus Torquatus ſimulabat ſe eſſe Chriſtianũ:" HPOS="571.0" VPOS="2306.0" WIDTH="1582.0" HEIGHT="60.0" WC="0.9881660019650179"/>
          </TextLine>
          <TextLine ID="line_47" TAGREFS="LT8" BASELINE="575 2380 2151 2395" HPOS="573.0" VPOS="2350.0" WIDTH="1578.0" HEIGHT="69.0">
            <Shape><Polygon POINTS="575 2380 573 2399 2147 2419 2151 2395 2149 2362 575 2350 575 2380"/></Shape>
            <String CONTENT="vt fidelis Tiburtius qui eum in fide illuminare voluerat raperetur ad tormenta aut" HPOS="573.0" VPOS="2350.0" WIDTH="1578.0" HEIGHT="69.0"/>
          </TextLine>
          <TextLine ID="line_48" TAGREFS="LT8" BASELINE="573 2427 2149 2439" HPOS="571.0" VPOS="2386.0" WIDTH="1578.0" HEIGHT="69.0">
            <Shape><Polygon POINTS="573 2427 571 2451 2145 2455 2149 2439 2147 2407 573 2386 573 2427"/></Shape>
            <String CONTENT="idolis immolaret ſi inquam ſimulas fidem: eum ſimulata fide non eſt perfecta dilectio." HPOS="571.0" VPOS="2386.0" WIDTH="1578.0" HEIGHT="69.0" WC="0.9965213592662368"/>
          </TextLine>
          <TextLine ID="line_49" TAGREFS="LT8" BASELINE="575 2469 2153 2479" HPOS="573.0" VPOS="2439.0" WIDTH="1580.0" HEIGHT="61.0">
            <Shape><Polygon POINTS="575 2469 573 2489 2149 2500 2153 2479 2151 2447 575 2439 575 2469"/></Shape>
            <String CONTENT="ſine enim fide: impoſſibile eſt placere deo. &amp; cum ſimulata fides non ſit fides: vir ſimu¬" HPOS="573.0" VPOS="2439.0" WIDTH="1580.0" HEIGHT="61.0"/>
          </TextLine>
          <TextLine ID="line_50" TAGREFS="LT8" BASELINE="575 2516 2153 2528" HPOS="573.0" VPOS="2475.0" WIDTH="1580.0" HEIGHT="71.0">
            <Shape><Polygon POINTS="575 2516 573 2538 2149 2546 2153 2528 2151 2496 575 2475 575 2516"/></Shape>
            <String CONTENT="latæ fideil deo non placet! immo diſplicet. non igitur dilectionem habet: quæ eſt mu¬" HPOS="573.0" VPOS="2475.0" WIDTH="1580.0" HEIGHT="71.0" WC="0.9924837946891785"/>
          </TextLine>
          <TextLine ID="line_51" TAGREFS="LT8" BASELINE="575 2556 2155 2572" HPOS="573.0" VPOS="2526.0" WIDTH="1582.0" HEIGHT="68.0">
            <Shape><Polygon POINTS="575 2556 573 2574 2151 2594 2155 2572 2155 2534 575 2526 575 2556"/></Shape>
            <String CONTENT="nus dei! quod ipſe elargitur amicis. Vt igitur perfecta dilectio in nobis eſſe poſſit: ſit" HPOS="573.0" VPOS="2526.0" WIDTH="1582.0" HEIGHT="68.0" WC="0.9946187920040555"/>
          </TextLine>
          <TextLine ID="line_52" TAGREFS="LT8" BASELINE="575 2605 2153 2617" HPOS="573.0" VPOS="2572.0" WIDTH="1580.0" HEIGHT="61.0">
            <Shape><Polygon POINTS="575 2605 573 2625 2149 2633 2153 2617 2151 2582 575 2572 575 2605"/></Shape>
            <String CONTENT="cor purum ſit conſcientia bona ſit fides ſyncæra &amp; non ſimulata, vt cor purum &amp; mũ¬" HPOS="573.0" VPOS="2572.0" WIDTH="1580.0" HEIGHT="61.0"/>
          </TextLine>
          <TextLine ID="line_53" TAGREFS="LT8" BASELINE="575 2645 2151 2665" HPOS="573.0" VPOS="2613.0" WIDTH="1578.0" HEIGHT="70.0">
            <Shape><Polygon POINTS="575 2645 573 2669 2147 2683 2151 2665 2149 2633 575 2613 575 2645"/></Shape>
            <String CONTENT="dum habeamus: a deo efflagitemus qui ſumma eſt puritas. vt conſcientiam bonam:" HPOS="573.0" VPOS="2613.0" WIDTH="1578.0" HEIGHT="70.0"/>
          </TextLine>
          <TextLine ID="line_54" TAGREFS="LT8" BASELINE="575 2691 2151 2712" HPOS="573.0" VPOS="2655.0" WIDTH="1578.0" HEIGHT="73.0">
            <Shape><Polygon POINTS="575 2691 573 2710 2147 2728 2151 2712 2149 2679 575 2655 575 2691"/></Shape>
            <String CONTENT="ab eodem qui ſumma eſt bonitas. fidem etiam non ſimulatam ab eodem: quia ſumma" HPOS="573.0" VPOS="2655.0" WIDTH="1578.0" HEIGHT="73.0" WC="0.998209040134381"/>
          </TextLine>
          <TextLine ID="line_55" TAGREFS="LT8" BASELINE="575 2734 2149 2756" HPOS="573.0" VPOS="2702.0" WIDTH="1576.0" HEIGHT="76.0">
            <Shape><Polygon POINTS="575 2734 573 2754 2145 2778 2149 2756 2147 2724 575 2702 575 2734"/></Shape>
            <String CONTENT="eſt veritas. Qui cor purum non habent conſcientiam bonam( &amp; fidem ſyncæram ab¬" HPOS="573.0" VPOS="2702.0" WIDTH="1576.0" HEIGHT="76.0" WC="0.9919195106396308"/>
          </TextLine>
          <TextLine ID="line_56" TAGREFS="LT8" BASELINE="577 2778 2149 2800" HPOS="575.0" VPOS="2742.0" WIDTH="1574.0" HEIGHT="75.0">
            <Shape><Polygon POINTS="577 2778 575 2794 2145 2817 2149 2800 2147 2766 577 2742 577 2778"/></Shape>
            <String CONTENT="errant &amp; vana loquuntur: vt imperiti medicit neſcientes &amp; quæ loquuntur! &amp; de qui¬" HPOS="575.0" VPOS="2742.0" WIDTH="1574.0" HEIGHT="75.0" WC="0.9895306760218086"/>
          </TextLine>
          <TextLine ID="line_57" TAGREFS="LT8" BASELINE="575 2823 2153 2847" HPOS="573.0" VPOS="2780.0" WIDTH="1580.0" HEIGHT="83.0">
            <Shape><Polygon POINTS="575 2823 573 2839 2149 2863 2153 2847 2153 2811 575 2780 575 2823"/></Shape>
            <String CONTENT="bus affirmant. Quo in genere maxime delinquunt qui iudaizant. loquuntur enim de" HPOS="573.0" VPOS="2780.0" WIDTH="1580.0" HEIGHT="83.0" WC="0.9924173619173751"/>
          </TextLine>
          <TextLine ID="line_58" TAGREFS="LT8" BASELINE="573 2865 2155 2891" HPOS="571.0" VPOS="2825.0" WIDTH="1584.0" HEIGHT="83.0">
            <Shape><Polygon POINTS="573 2865 571 2881 2151 2908 2155 2891 2155 2851 573 2825 573 2865"/></Shape>
            <String CONTENT="lege: ſed non intelligunt. nam ſpiritualis eſt: ipſi vero carnaliter concipiunt. &amp; figu¬" HPOS="571.0" VPOS="2825.0" WIDTH="1584.0" HEIGHT="83.0" WC="0.9923784908923236"/>
          </TextLine>
          <TextLine ID="line_59" TAGREFS="LT8" BASELINE="573 2908 2157 2936" HPOS="571.0" VPOS="2877.0" WIDTH="1586.0" HEIGHT="81.0">
            <Shape><Polygon POINTS="573 2908 571 2926 2153 2958 2157 2936 2157 2905 573 2877 573 2908"/></Shape>
            <String CONTENT="ris inhærent: de eis affirmantes! quæ debentur exemplaribus, tribuunt vmbræ: quæ" HPOS="571.0" VPOS="2877.0" WIDTH="1586.0" HEIGHT="81.0" WC="0.9980320259928703"/>
          </TextLine>
          <TextLine ID="line_60" TAGREFS="LT8" BASELINE="573 2954 2155 2980" HPOS="571.0" VPOS="2916.0" WIDTH="1584.0" HEIGHT="78.0">
            <Shape><Polygon POINTS="573 2954 571 2974 2151 2994 2155 2980 2153 2946 573 2916 573 2954"/></Shape>
            <String CONTENT="debentur veritati. Ergo dices: lex mala eſt? Nequaq mala eſt: niſi male vtentibus!" HPOS="571.0" VPOS="2916.0" WIDTH="1584.0" HEIGHT="78.0" WC="0.9906967165993481"/>
          </TextLine>
          <TextLine ID="line_61" TAGREFS="LT8" BASELINE="571 2996 2161 3027" HPOS="569.0" VPOS="2960.0" WIDTH="1592.0" HEIGHT="107.0">
            <Shape><Polygon POINTS="571 2996 569 3023 694 3035 696 3035 775 3027 805 3043 807 3043 809 3043 1310 3037 1343 3049 1345 3049 1347 3049 1411 3039 1522 3057 1525 3057 1625 3045 1660 3059 1662 3059 1664 3059 1666 3059 1716 3045 1747 3061 1749 3061 1751 3061 1825 3051 1890 3061 1892 3061 1894 3061 1896 3061 1912 3051 2157 3067 2161 3027 2151 2992 571 2960 571 2996"/></Shape>
            <String CONTENT="&amp; male intelligentibus. vt &amp; medicina bona eſt: ſed bene intelligentibus at bene" HPOS="569.0" VPOS="2960.0" WIDTH="1592.0" HEIGHT="107.0" WC="0.9954037563300427"/>
          </TextLine>
