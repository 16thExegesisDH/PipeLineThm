            <Shape><Polygon POINTS="28 778 27 788 751 793 753 782 752 764 474 758 473 758 345 762 290 757 289 757 28 760 28 778"/></Shape>
            <String CONTENT="bus. Non quidem ut de bonis ſuis præſumere incipiant, &amp; ſibi placeant, uel ſen¬" HPOS="27.0" VPOS="757.0" WIDTH="726.0" HEIGHT="36.0" WC="0.9860434916955007"/>
          </TextLine>
          <TextLine ID="line_30" TAGREFS="LT8" BASELINE="28 803 319 801 752 807" HPOS="27.0" VPOS="781.0" WIDTH="725.0" HEIGHT="34.0">
            <Shape><Polygon POINTS="28 803 27 811 750 815 752 807 751 789 627 789 617 784 616 784 615 784 359 786 337 782 336 782 226 785 212 781 211 781 210 781 28 784 28 803"/></Shape>
            <String CONTENT="ſu abundent, ſed ut bona opera à deo mãdata, cum dei adiutorio, obediendo, per¬" HPOS="27.0" VPOS="781.0" WIDTH="725.0" HEIGHT="34.0" WC="0.9786271968005616"/>
          </TextLine>
          <TextLine ID="line_31" TAGREFS="LT8" BASELINE="28 828 341 826 752 830" HPOS="27.0" VPOS="806.0" WIDTH="725.0" HEIGHT="35.0">
            <Shape><Polygon POINTS="28 828 27 836 750 841 752 830 751 814 663 808 662 808 619 813 610 808 609 808 608 808 574 813 518 807 517 807 372 811 335 807 334 807 267 811 164 806 163 806 162 806 147 810 100 806 99 806 47 810 38 806 37 806 36 806 35 806 28 809 28 828"/></Shape>
            <String CONTENT="ficiant, ſe ut inutiles ſeruos credant, ac profiteantur ingenue. Quod facere de¬" HPOS="27.0" VPOS="806.0" WIDTH="725.0" HEIGHT="35.0" WC="0.9902253246601717"/>
          </TextLine>
          <TextLine ID="line_32" TAGREFS="LT8" BASELINE="28 852 367 850 749 856" HPOS="28.0" VPOS="829.0" WIDTH="721.0" HEIGHT="36.0">
            <Shape><Polygon POINTS="28 852 28 862 259 859 266 864 266 864 267 864 268 864 384 860 748 865 749 856 748 837 28 829 28 852"/></Shape>
            <String CONTENT="bent, hoc faciant, non ſpe mercedis, ſed inſtinctu charitatis, &amp; fiduciæ in deum." HPOS="28.0" VPOS="829.0" WIDTH="721.0" HEIGHT="36.0" WC="0.9938261700265202"/>
          </TextLine>
          <TextLine ID="line_33" TAGREFS="LT8" BASELINE="28 876 751 878" HPOS="27.0" VPOS="857.0" WIDTH="724.0" HEIGHT="32.0">
            <Shape><Polygon POINTS="28 876 27 887 749 889 751 878 750 861 28 857 28 876"/></Shape>
            <String CONTENT="Nominat autem diuites éos, qui dediti ſunt operibus miſericordiæ, qui ſoli diui¬" HPOS="27.0" VPOS="857.0" WIDTH="724.0" HEIGHT="32.0" WC="0.9864323705802729"/>
          </TextLine>
          <TextLine ID="line_34" TAGREFS="LT8" BASELINE="28 901 392 900 752 903" HPOS="27.0" VPOS="879.0" WIDTH="725.0" HEIGHT="35.0">
            <Shape><Polygon POINTS="28 901 27 910 750 914 752 903 751 885 588 885 575 880 575 880 574 880 496 885 448 880 447 880 446 880 434 885 382 879 381 879 330 884 301 879 86 879 85 879 28 884 28 901"/></Shape>
            <String CONTENT="tias habere cenſentur coram deo, cum ſcilicet legitime ac religioſe adminiſtrant" HPOS="27.0" VPOS="879.0" WIDTH="725.0" HEIGHT="35.0" WC="0.9903166152536869"/>
          </TextLine>
          <TextLine ID="line_35" TAGREFS="LT8" BASELINE="27 925 752 928" HPOS="26.0" VPOS="903.0" WIDTH="726.0" HEIGHT="34.0">
            <Shape><Polygon POINTS="26 933 750 937 752 928 751 911 613 911 604 906 603 906 602 906 601 906 600 906 594 911 526 911 491 905 490 905 489 905 471 909 438 905 437 905 260 908 254 904 253 904 252 904 251 904 42 908 28 903 27 925 26 933"/></Shape>
            <String CONTENT="iuxta commiſſionem dei, cuius procuratores conſtituuntur. Vnde ad mentem" HPOS="26.0" VPOS="903.0" WIDTH="726.0" HEIGHT="34.0" WC="0.9980945620271895"/>
          </TextLine>
          <TextLine ID="line_36" TAGREFS="LT8" BASELINE="27 950 402 949 749 953" HPOS="26.0" VPOS="931.0" WIDTH="723.0" HEIGHT="33.0">
            <Shape><Polygon POINTS="27 950 26 958 748 964 749 953 748 935 27 931 27 950"/></Shape>
            <String CONTENT="&amp; modum loquendi apoſtoli Pauli, Diuites fieri in operibus bonis, aliud non eſt," HPOS="26.0" VPOS="931.0" WIDTH="723.0" HEIGHT="33.0" WC="0.9928789488971234"/>
          </TextLine>
          <TextLine ID="line_37" TAGREFS="LT8" BASELINE="28 973 750 977" HPOS="27.0" VPOS="953.0" WIDTH="723.0" HEIGHT="35.0">
            <Shape><Polygon POINTS="28 973 27 981 32 985 33 985 34 985 35 985 199 982 244 986 244 986 354 983 395 987 395 988 749 988 750 977 749 961 705 956 705 956 704 956 690 961 576 961 494 960 488 955 487 955 486 955 399 955 398 955 397 955 388 959 360 954 244 954 243 954 242 954 232 958 208 953 207 953 184 957 148 953 147 953 28 955 28 973"/></Shape>
            <String CONTENT="quàm opera pietatis de diuitiarum abundãtia affatim exercere, opera uere bona" HPOS="27.0" VPOS="953.0" WIDTH="723.0" HEIGHT="35.0" WC="0.9987897639033161"/>
          </TextLine>
          <TextLine ID="line_38" TAGREFS="LT8" BASELINE="28 1000 395 998 748 1002" HPOS="27.0" VPOS="977.0" WIDTH="721.0" HEIGHT="36.0">
            <Shape><Polygon POINTS="28 1000 27 1007 746 1013 748 1002 747 984 517 984 496 978 495 978 494 978 243 982 229 977 228 977 227 977 28 981 28 1000"/></Shape>
            <String CONTENT="ac religioſa multiplicare, iuxta facultatem domini illis donatam abũde præ alijs." HPOS="27.0" VPOS="977.0" WIDTH="721.0" HEIGHT="36.0" WC="0.9926693911959485"/>
          </TextLine>
          <TextLine ID="line_39" TAGREFS="LT8" BASELINE="28 1023 409 1022 751 1027" HPOS="27.0" VPOS="1002.0" WIDTH="724.0" HEIGHT="34.0">
            <Shape><Polygon POINTS="28 1023 27 1035 749 1036 751 1027 750 1008 358 1008 289 1003 288 1003 160 1007 142 1002 141 1002 140 1002 28 1006 28 1023"/></Shape>
            <String CONTENT="Ne cõtingat eos egere maxime, cum minime uelint, cum diuite epulone, cuigut" HPOS="27.0" VPOS="1002.0" WIDTH="724.0" HEIGHT="34.0" WC="0.9942252784967422"/>
          </TextLine>
          <TextLine ID="line_40" TAGREFS="LT8" BASELINE="28 1047 751 1050" HPOS="28.0" VPOS="1030.0" WIDTH="723.0" HEIGHT="32.0">
            <Shape><Polygon POINTS="28 1047 28 1055 234 1060 235 1060 358 1057 407 1061 408 1061 567 1057 589 1062 590 1062 750 1057 751 1050 750 1032 28 1030 28 1047"/></Shape>
            <String CONTENT="ta aquæ negata fuit, diuiti rebus olim, ſed egeno gratia dei &amp; bonis operibus. Bo" HPOS="28.0" VPOS="1030.0" WIDTH="723.0" HEIGHT="32.0" WC="0.994884729385376"/>
          </TextLine>
          <TextLine ID="line_41" TAGREFS="LT8" BASELINE="28 1071 751 1075" HPOS="28.0" VPOS="1055.0" WIDTH="723.0" HEIGHT="27.0">
            <Shape><Polygon POINTS="28 1071 28 1078 749 1082 751 1075 750 1058 28 1055 28 1071"/></Shape>
            <String CONTENT="na opera quæ uere dicantur &amp; ſint, hactenus ignoratum fuit à multis: nũc diſua¬" HPOS="28.0" VPOS="1055.0" WIDTH="723.0" HEIGHT="27.0" WC="0.9879004756609598"/>
          </TextLine>
          <TextLine ID="line_42" TAGREFS="LT8" BASELINE="28 1094 750 1099" HPOS="28.0" VPOS="1077.0" WIDTH="722.0" HEIGHT="30.0">
            <Shape><Polygon POINTS="28 1094 28 1106 748 1107 750 1099 749 1083 607 1083 603 1078 603 1078 602 1078 601 1078 600 1078 482 1081 461 1077 460 1077 28 1078 28 1094"/></Shape>
            <String CONTENT="deri incipiunt non uere bona opera, ſed quæ falſo putabantur bona: ſuadentur" HPOS="28.0" VPOS="1077.0" WIDTH="722.0" HEIGHT="30.0" WC="0.9973036866439017"/>
          </TextLine>
          <TextLine ID="line_43" TAGREFS="LT8" BASELINE="29 1120 752 1124" HPOS="28.0" VPOS="1100.0" WIDTH="724.0" HEIGHT="35.0">
            <Shape><Polygon POINTS="29 1120 28 1130 750 1135 752 1124 751 1107 174 1100 173 1100 29 1102 29 1120"/></Shape>
            <String CONTENT="autem à doctis &amp; pijs hoc noſtro tempore &amp; docentur ea bona opera, quæ uere" HPOS="28.0" VPOS="1100.0" WIDTH="724.0" HEIGHT="35.0" WC="0.9889054439569774"/>
          </TextLine>
          <TextLine ID="line_44" TAGREFS="LT8" BASELINE="28 1145 751 1149" HPOS="28.0" VPOS="1127.0" WIDTH="723.0" HEIGHT="29.0">
            <Shape><Polygon POINTS="28 1145 28 1154 749 1156 751 1149 750 1131 28 1127 28 1145"/></Shape>
            <String CONTENT="bona ſunt, quia à deo præcepta, laudata &amp; muneranda. Diuites autem erimus" HPOS="28.0" VPOS="1127.0" WIDTH="723.0" HEIGHT="29.0" WC="0.9834581331626789"/>
          </TextLine>
          <TextLine ID="line_45" TAGREFS="LT8" BASELINE="28 1170 751 1173" HPOS="27.0" VPOS="1152.0" WIDTH="724.0" HEIGHT="30.0">
            <Shape><Polygon POINTS="28 1170 27 1177 749 1182 751 1173 750 1156 28 1152 28 1170"/></Shape>
            <String CONTENT="non in hoc ſæculo, ſed in cœlo. Illuc enim theſaurizandum, quia hic ſemper pau¬" HPOS="27.0" VPOS="1152.0" WIDTH="724.0" HEIGHT="30.0" WC="0.9900652856766423"/>
          </TextLine>
          <TextLine ID="line_46" TAGREFS="LT8" BASELINE="28 1193 751 1198" HPOS="28.0" VPOS="1172.0" WIDTH="723.0" HEIGHT="34.0">
            <Shape><Polygon POINTS="28 1193 28 1206 750 1206 751 1198 750 1180 28 1172 28 1193"/></Shape>
            <String CONTENT="peres erimus, plura debentes,  præſtare poſſimus, ſemper peccatores, ſemper" HPOS="28.0" VPOS="1172.0" WIDTH="723.0" HEIGHT="34.0" WC="0.9928958392456958"/>
          </TextLine>
          <TextLine ID="line_47" TAGREFS="LT8" BASELINE="29 1217 751 1222" HPOS="28.0" VPOS="1200.0" WIDTH="723.0" HEIGHT="30.0">
            <Shape><Polygon POINTS="29 1217 28 1225 749 1230 751 1222 750 1206 29 1200 29 1217"/></Shape>
            <String CONTENT="orantes pro peccatis remittendis, de operibus bonis nihil præſumentes. De miſe" HPOS="28.0" VPOS="1200.0" WIDTH="723.0" HEIGHT="30.0" WC="0.9949653775264056"/>
          </TextLine>
          <TextLine ID="line_48" TAGREFS="LT8" BASELINE="29 1242 751 1247" HPOS="28.0" VPOS="1225.0" WIDTH="723.0" HEIGHT="30.0">
            <Shape><Polygon POINTS="29 1242 28 1251 749 1255 751 1247 750 1230 29 1225 29 1242"/></Shape>
            <String CONTENT="ricordia dei &amp; fide noſtra tantum gloriemur, non in nobis, qui nec fidem præſta¬" HPOS="28.0" VPOS="1225.0" WIDTH="723.0" HEIGHT="30.0" WC="0.99417794495821"/>
          </TextLine>
          <TextLine ID="line_49" TAGREFS="LT8" BASELINE="29 1266 753 1271" HPOS="28.0" VPOS="1248.0" WIDTH="725.0" HEIGHT="33.0">
            <Shape><Polygon POINTS="29 1266 28 1274 751 1281 753 1271 751 1250 638 1253 614 1249 613 1249 518 1252 507 1248 506 1248 29 1248 29 1266"/></Shape>
            <String CONTENT="mus ex nobis nec opera, ſed domino largiente utra ſuſcipimus. In eo autẽ quod" HPOS="28.0" VPOS="1248.0" WIDTH="725.0" HEIGHT="33.0" WC="0.9843707175194463"/>
          </TextLine>
          <TextLine ID="line_50" TAGREFS="LT8" BASELINE="29 1291 749 1296" HPOS="28.0" VPOS="1273.0" WIDTH="721.0" HEIGHT="36.0">
            <Shape><Polygon POINTS="29 1291 28 1298 54 1304 55 1304 146 1300 173 1305 174 1305 254 1300 294 1306 294 1306 382 1301 428 1307 429 1307 453 1303 589 1307 590 1307 591 1307 601 1303 629 1308 630 1309 748 1309 749 1296 748 1279 29 1273 29 1291"/></Shape>
            <String CONTENT="ſequitur, Facile communicare.) Adhuc hortari docentur diuites ab epiſcopo," HPOS="28.0" VPOS="1273.0" WIDTH="721.0" HEIGHT="36.0" WC="0.9932802947791847"/>
          </TextLine>
