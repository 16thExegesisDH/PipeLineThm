<?xml version="1.0" encoding="UTF-8"?>
<grammar ns="http://www.tei-c.org/ns/1.0" xmlns="http://relaxng.org/ns/structure/1.0" datatypeLibrary="http://www.w3.org/2001/XMLSchema-datatypes">
  <start>
    <element name="TEI">
      <attribute>
        <name ns="http://www.w3.org/XML/1998/namespace">id</name>
        <data type="NCName"/>
      </attribute>
      <element name="teiHeader">
        <element name="fileDesc">
          <element name="titleStmt">
            <ref name="title"/>
            <oneOrMore>
              <ref name="respStmt"/>
            </oneOrMore>
          </element>
          <element name="extent">
            <oneOrMore>
              <element name="measure">
                <attribute name="n">
                  <data type="integer"/>
                </attribute>
                <attribute name="unit">
                  <data type="NCName"/>
                </attribute>
              </element>
            </oneOrMore>
          </element>
          <element name="publicationStmt">
            <element name="publisher">
              <text/>
            </element>
            <oneOrMore>
              <choice>
                <element name="address">
                  <oneOrMore>
                    <element name="addrLine">
                      <text/>
                    </element>
                  </oneOrMore>
                </element>
                <element name="authority">
                  <text/>
                </element>
              </choice>
            </oneOrMore>
            <element name="availability">
              <attribute name="n">
                <data type="NCName"/>
              </attribute>
              <attribute name="status">
                <data type="NCName"/>
              </attribute>
              <element name="licence">
                <attribute name="target">
                  <data type="anyURI"/>
                </attribute>
              </element>
              <ref name="p"/>
            </element>
            <ref name="date"/>
          </element>
          <element name="sourceDesc">
            <element name="msDesc">
              <element name="msIdentifier">
                <attribute>
                  <name ns="http://www.w3.org/XML/1998/namespace">id</name>
                  <data type="NCName"/>
                </attribute>
                <element name="country">
                  <data type="NCName"/>
                </element>
                <element name="settlement">
                  <data type="NCName"/>
                </element>
                <element name="institution">
                  <text/>
                </element>
                <ref name="idno"/>
              </element>
              <element name="msContents">
                <ref name="p"/>
              </element>
              <element name="physDesc">
                <element name="objectDesc">
                  <element name="supportDesc">
                    <element name="support">
                      <element name="dim">
                        <text/>
                      </element>
                    </element>
                  </element>
                </element>
              </element>
              <element name="additional">
                <element name="surrogates">
                  <ref name="bibl"/>
                </element>
                <element name="listBibl">
                  <ref name="bibl"/>
                </element>
              </element>
            </element>
          </element>
        </element>
        <element name="encodingDesc">
          <element name="projectDesc">
            <ref name="p"/>
          </element>
          <element name="editorialDecl">
            <element name="correction">
              <ref name="p"/>
            </element>
            <element name="normalization">
              <ref name="p"/>
            </element>
          </element>
          <oneOrMore>
            <element name="appInfo">
              <element name="application">
                <attribute name="ident">
                  <data type="NCName"/>
                </attribute>
                <attribute name="version">
                  <data type="decimal"/>
                </attribute>
                <element name="label">
                  <data type="NCName"/>
                </element>
                <ref name="ptr"/>
              </element>
            </element>
          </oneOrMore>
          <element name="classDecl">
            <element name="taxonomy">
              <attribute>
                <name ns="http://www.w3.org/XML/1998/namespace">id</name>
                <data type="NCName"/>
              </attribute>
              <ref name="bibl"/>
              <oneOrMore>
                <element name="category">
                  <attribute>
                    <name ns="http://www.w3.org/XML/1998/namespace">id</name>
                    <data type="NCName"/>
                  </attribute>
                </element>
              </oneOrMore>
            </element>
          </element>
        </element>
        <element name="profileDesc">
          <element name="langUsage">
            <element name="language">
              <attribute name="ident">
                <data type="NCName"/>
              </attribute>
              <text/>
            </element>
          </element>
          <element name="textClass">
            <element name="keywords">
              <oneOrMore>
                <element name="term">
                  <attribute name="type">
                    <data type="NCName"/>
                  </attribute>
                  <text/>
                </element>
              </oneOrMore>
            </element>
          </element>
        </element>
        <element name="revisionDesc">
          <element name="change">
            <attribute name="when">
              <data type="date"/>
            </attribute>
            <attribute name="who"/>
            <text/>
          </element>
        </element>
      </element>
      <element name="sourceDoc">
        <oneOrMore>
          <element name="surface">
            <attribute name="lrx">
              <data type="integer"/>
            </attribute>
            <attribute name="lry">
              <data type="integer"/>
            </attribute>
            <attribute name="ulx">
              <data type="integer"/>
            </attribute>
            <attribute name="uly">
              <data type="integer"/>
            </attribute>
            <attribute>
              <name ns="http://www.w3.org/XML/1998/namespace">id</name>
              <data type="NCName"/>
            </attribute>
            <element name="graphic">
              <attribute name="url">
                <data type="anyURI"/>
              </attribute>
            </element>
            <oneOrMore>
              <ref name="zone"/>
            </oneOrMore>
          </element>
        </oneOrMore>
      </element>
      <element name="text">
        <element name="body">
          <oneOrMore>
            <choice>
              <element name="ab">
                <attribute name="corresp"/>
                <attribute name="type">
                  <data type="NCName"/>
                </attribute>
                <choice>
                  <element name="hi">
                    <ref name="lb"/>
                    <ref name="choice"/>
                  </element>
                  <oneOrMore>
                    <choice>
                      <ref name="choice"/>
                      <ref name="lb"/>
                    </choice>
                  </oneOrMore>
                </choice>
              </element>
              <element name="fw">
                <attribute name="corresp"/>
                <attribute name="type">
                  <data type="NCName"/>
                </attribute>
                <oneOrMore>
                  <choice>
                    <ref name="choice"/>
                    <ref name="lb"/>
                  </choice>
                </oneOrMore>
              </element>
              <element name="pb">
                <attribute name="corresp">
                  <data type="NCName"/>
                </attribute>
              </element>
            </choice>
          </oneOrMore>
        </element>
      </element>
    </element>
  </start>
  <define name="title">
    <element name="title">
      <optional>
        <attribute name="type">
          <data type="NCName"/>
        </attribute>
      </optional>
      <text/>
    </element>
  </define>
  <define name="respStmt">
    <element name="respStmt">
      <element name="resp">
        <text/>
      </element>
      <ref name="persName"/>
    </element>
  </define>
  <define name="p">
    <element name="p">
      <oneOrMore>
        <choice>
          <text/>
          <element name="biblStruct">
            <element name="monogr">
              <element name="author">
                <ref name="persName"/>
              </element>
              <oneOrMore>
                <ref name="title"/>
              </oneOrMore>
              <element name="imprint">
                <element name="pubPlace">
                  <attribute name="cert">
                    <data type="NCName"/>
                  </attribute>
                  <attribute name="ref">
                    <data type="NMTOKEN"/>
                  </attribute>
                  <data type="NCName"/>
                </element>
                <ref name="respStmt"/>
                <ref name="date"/>
              </element>
            </element>
          </element>
        </choice>
      </oneOrMore>
    </element>
  </define>
  <define name="date">
    <element name="date">
      <optional>
        <attribute name="cert">
          <data type="NCName"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="when">
          <data type="date"/>
        </attribute>
      </optional>
      <text/>
    </element>
  </define>
  <define name="idno">
    <element name="idno">
      <optional>
        <attribute name="type">
          <data type="NCName"/>
        </attribute>
      </optional>
      <text/>
    </element>
  </define>
  <define name="bibl">
    <element name="bibl">
      <optional>
        <ref name="ref"/>
      </optional>
      <optional>
        <choice>
          <element name="relatedItem">
            <attribute name="type">
              <data type="NCName"/>
            </attribute>
            <ref name="ref"/>
          </element>
          <group>
            <ref name="title"/>
            <ref name="ptr"/>
          </group>
        </choice>
      </optional>
    </element>
  </define>
  <define name="ptr">
    <element name="ptr">
      <attribute name="target">
        <data type="anyURI"/>
      </attribute>
      <optional>
        <attribute name="type">
          <data type="NCName"/>
        </attribute>
      </optional>
    </element>
  </define>
  <define name="zone">
    <element name="zone">
      <attribute name="lrx">
        <data type="decimal"/>
      </attribute>
      <attribute name="lry">
        <data type="decimal"/>
      </attribute>
      <attribute name="n">
        <data type="integer"/>
      </attribute>
      <attribute name="points"/>
      <attribute name="source"/>
      <attribute name="type">
        <data type="NCName"/>
      </attribute>
      <attribute name="ulx">
        <data type="decimal"/>
      </attribute>
      <attribute name="uly">
        <data type="decimal"/>
      </attribute>
      <attribute>
        <name ns="http://www.w3.org/XML/1998/namespace">id</name>
        <data type="NCName"/>
      </attribute>
      <optional>
        <ref name="zone"/>
        <element name="path">
          <attribute name="n">
            <data type="integer"/>
          </attribute>
          <attribute name="points"/>
          <attribute name="type">
            <data type="NCName"/>
          </attribute>
          <attribute>
            <name ns="http://www.w3.org/XML/1998/namespace">id</name>
            <data type="NCName"/>
          </attribute>
        </element>
        <element name="line">
          <attribute>
            <name ns="http://www.w3.org/XML/1998/namespace">id</name>
            <data type="NCName"/>
          </attribute>
          <text/>
        </element>
      </optional>
    </element>
  </define>
  <define name="lb">
    <element name="lb">
      <attribute name="corresp"/>
    </element>
  </define>
  <define name="choice">
    <element name="choice">
      <element name="orig">
        <text/>
      </element>
      <element name="reg">
        <attribute name="type">
          <data type="NCName"/>
        </attribute>
        <text/>
      </element>
    </element>
  </define>
  <define name="persName">
    <element name="persName">
      <optional>
        <attribute name="ref">
          <data type="NMTOKEN"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="role">
          <data type="NCName"/>
        </attribute>
      </optional>
      <optional>
        <attribute>
          <name ns="http://www.w3.org/XML/1998/namespace">id</name>
          <data type="NCName"/>
        </attribute>
      </optional>
      <oneOrMore>
        <choice>
          <element name="forename">
            <data type="NCName"/>
          </element>
          <element name="surname">
            <data type="NCName"/>
          </element>
        </choice>
      </oneOrMore>
      <optional>
        <ref name="ptr"/>
      </optional>
    </element>
  </define>
  <define name="ref">
    <element name="ref">
      <attribute name="target">
        <data type="anyURI"/>
      </attribute>
      <oneOrMore>
        <choice>
          <text/>
          <ref name="idno"/>
          <element name="orgName">
            <data type="NCName"/>
          </element>
        </choice>
      </oneOrMore>
    </element>
  </define>
</grammar>
