            <String CONTENT="ergo diaconi veraces: vt veritatis miniſtri eſſe poſſint! qui Chriſto dominus eſt. Tertio." HPOS="38.0" VPOS="2635.0" WIDTH="1597.0" HEIGHT="60.0" WC="0.9895857036113739"/>
          </TextLine>
