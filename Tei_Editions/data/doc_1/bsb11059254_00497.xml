            <String CONTENT="uiciatum teſtimonium bonũ &amp; ab ijs quibus præficiendus eſt &amp; ab exteris. Ad diaco¬" HPOS="36.0" VPOS="2456.0" WIDTH="1599.0" HEIGHT="68.0" WC="0.9948913677629218"/>
          </TextLine>
          <TextLine ID="line_48" TAGREFS="LT8" BASELINE="36 2542 1637 2532" HPOS="34.0" VPOS="2498.0" WIDTH="1603.0" HEIGHT="69.0">
