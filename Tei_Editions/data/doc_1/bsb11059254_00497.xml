            <Shape><Polygon POINTS="40 2101 40 2120 1633 2111 1635 2089 1629 2053 38 2067 40 2101"/></Shape>
            <String CONTENT="myſterium fidei in conſcientia pura. &amp; ipſi quidem probentur primũ: deinde miniſtrẽt!" HPOS="38.0" VPOS="2053.0" WIDTH="1597.0" HEIGHT="67.0" WC="0.9921414584949099"/>
          </TextLine>
          <TextLine ID="line_39" TAGREFS="LT8" BASELINE="46 2144 1637 2136" HPOS="44.0" VPOS="2105.0" WIDTH="1593.0" HEIGHT="57.0">
