            <String CONTENT="norũ vero inſtitutionem nouem enumerat. Primo. ꝙ caſti ſint. hoc: carnis prohibet di¬" HPOS="34.0" VPOS="2498.0" WIDTH="1603.0" HEIGHT="69.0" WC="0.9922608490600142"/>
          </TextLine>
