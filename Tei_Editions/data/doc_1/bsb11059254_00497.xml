            <String CONTENT="fideles in omnibus. Diaconi ſint vnius vxoris viri: qui liberis honeſte præſint! &amp; pro¬" HPOS="40.0" VPOS="2142.0" WIDTH="1599.0" HEIGHT="72.0" WC="0.9938069040747894"/>
          </TextLine>
          <TextLine ID="line_41" TAGREFS="LT8" BASELINE="42 2234 1641 2224" HPOS="40.0" VPOS="2184.0" WIDTH="1601.0" HEIGHT="72.0">
            <Shape><Polygon POINTS="42 2234 42 2256 1639 2246 1641 2224 1635 2184 40 2200 42 2234"/></Shape>
            <String CONTENT="prijs domibus. Nam qui bene miniſtrant: gradum bonum ſibi vendicant! &amp; multam fi" HPOS="40.0" VPOS="2184.0" WIDTH="1601.0" HEIGHT="72.0" WC="0.9943773299455643"/>
          </TextLine>
          <TextLine ID="line_42" TAGREFS="LT8" BASELINE="42 2277 1639 2269" HPOS="40.0" VPOS="2230.0" WIDTH="1599.0" HEIGHT="67.0">
