            <String CONTENT="cum ſine crimine ſint. vxores ſimili modo caſtas eſſe oportet. nõ calũniatrices! vigiles!" HPOS="44.0" VPOS="2105.0" WIDTH="1593.0" HEIGHT="57.0" WC="0.9886073358766325"/>
          </TextLine>
          <TextLine ID="line_40" TAGREFS="LT8" BASELINE="42 2188 1639 2180" HPOS="40.0" VPOS="2142.0" WIDTH="1599.0" HEIGHT="72.0">
