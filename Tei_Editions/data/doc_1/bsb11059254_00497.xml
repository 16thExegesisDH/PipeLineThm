            <String CONTENT="pten decim annumerauerat. irrepræhenſibilitatem ! monogamiam! vigilantiam! ca¬" HPOS="38.0" VPOS="2281.0" WIDTH="1599.0" HEIGHT="64.0" WC="0.9964084373070643"/>
          </TextLine>
          <TextLine ID="line_44" TAGREFS="LT8" BASELINE="36 2367 1639 2357" HPOS="34.0" VPOS="2317.0" WIDTH="1605.0" HEIGHT="66.0">
