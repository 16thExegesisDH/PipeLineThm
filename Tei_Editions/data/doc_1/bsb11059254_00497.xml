            <String CONTENT="ſe ſermone non duplices (non multo vino deditos non turpis lucri ſectatores! habẽtes" HPOS="28.0" VPOS="2013.0" WIDTH="1601.0" HEIGHT="64.0" WC="0.9957092390340917"/>
          </TextLine>
