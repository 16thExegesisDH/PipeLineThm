            <String CONTENT="cundo, ꝙ non ſint mendaces. quid enim aliud ſunt ſermone duplices: niſi mẽdaces? ſint" HPOS="36.0" VPOS="2587.0" WIDTH="1603.0" HEIGHT="64.0" WC="0.9785187701846279"/>
          </TextLine>
          <TextLine ID="line_51" TAGREFS="LT8" BASELINE="40 2677 1635 2667" HPOS="38.0" VPOS="2635.0" WIDTH="1597.0" HEIGHT="60.0">
