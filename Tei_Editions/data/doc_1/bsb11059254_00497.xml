            <String CONTENT="duciam in fide quæ eſt in CHRISTO IHESV. ¶ Ad inſtitutionem epiſcopi ſe¬" HPOS="40.0" VPOS="2230.0" WIDTH="1599.0" HEIGHT="67.0" WC="0.9914112256632911"/>
          </TextLine>
          <TextLine ID="line_43" TAGREFS="LT8" BASELINE="40 2325 1637 2313" HPOS="38.0" VPOS="2281.0" WIDTH="1599.0" HEIGHT="64.0">
