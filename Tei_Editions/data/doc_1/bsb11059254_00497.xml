            <String CONTENT="nam in re familiari præſidentiamlliberorum in omni honeſtate ſubiectionemi non no¬" HPOS="34.0" VPOS="2413.0" WIDTH="1601.0" HEIGHT="59.0" WC="0.9940493172261773"/>
          </TextLine>
          <TextLine ID="line_47" TAGREFS="LT8" BASELINE="38 2500 1635 2488" HPOS="36.0" VPOS="2456.0" WIDTH="1599.0" HEIGHT="68.0">
