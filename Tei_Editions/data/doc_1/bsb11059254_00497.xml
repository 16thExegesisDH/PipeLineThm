            <String CONTENT="procliuitatem non turpis lucri ſectationem mititatem! pacabilitateml liberalitatẽi bo¬" HPOS="34.0" VPOS="2369.0" WIDTH="1603.0" HEIGHT="69.0" WC="0.980462597019371"/>
          </TextLine>
          <TextLine ID="line_46" TAGREFS="LT8" BASELINE="36 2454 1635 2446" HPOS="34.0" VPOS="2413.0" WIDTH="1601.0" HEIGHT="59.0">
