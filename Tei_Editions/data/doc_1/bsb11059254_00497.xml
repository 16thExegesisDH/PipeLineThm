            <String CONTENT="ſtitatem! ornatum! hoſpitalitatem! docilitatem! non vinoſitatem! non percutiendi" HPOS="34.0" VPOS="2317.0" WIDTH="1605.0" HEIGHT="66.0" WC="0.9879681967198849"/>
          </TextLine>
